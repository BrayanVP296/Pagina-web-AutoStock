                    <div class="demo-form-group">
                        <input type="text" id="demoNombre" placeholder="Nombre" required>
                    </div>
                    <div class="demo-form-group">
                        <input type="text" id="demoApellidos" placeholder="Apellidos" required>
                    </div>
                </div>
                <div class="demo-form-group">
                    <input type="email" id="demoEmail" placeholder="Correo electrónico" required>
                </div>
                <div class="demo-form-row">
                    <div class="demo-form-group">
                        <input type="tel" id="demoTel" placeholder="Teléfono / WhatsApp">
                    </div>
                    <div class="demo-form-group">
                        <input type="text" id="demoEmpresa" placeholder="Empresa">
                    </div>
                </div>
                <div class="demo-form-group">
                    <input type="text" id="demoCiudad" placeholder="Ciudad">
                </div>
                <label class="demo-form-check">
                    <input type="checkbox" id="demoPrivacy" required>
                    <span>Al completar el formulario acepto la <a href="#" class="demo-link">Política de Tratamiento de
