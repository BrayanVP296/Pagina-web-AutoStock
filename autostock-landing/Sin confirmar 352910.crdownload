<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AutoStock — Sistema Inteligente de Gestión de Inventarios</title>
    <meta name="description"
        content="AutoStock centraliza, automatiza y optimiza la gestión de inventarios para PYMEs. Menos errores, más control, mayor rentabilidad.">
    <link rel="icon" href="assets/img/logo.png" type="image/png">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Inter:wght@400;500;600;700;800&family=Roboto:wght@400;500;700&display=swap"
        rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Estilos AutoStock -->
    <link rel="stylesheet" href="css/variables.css">
    <link rel="stylesheet" href="css/base.css">
    <link rel="stylesheet" href="css/components.css">
    <link rel="stylesheet" href="css/sections.css">

    <!-- EmailJS -->
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>

    <!-- Modal AutoStock — estilos embebidos para garantizar carga -->
    <style>
    /* ── OVERLAY ─────────────────────────────────────────────── */
    .demo-modal-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(5px);
      -webkit-backdrop-filter: blur(5px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.35s ease, visibility 0.35s ease;
    }
    .demo-modal-overlay.open {
      opacity: 1;
      visibility: visible;
    }

    /* ── CONTENEDOR ──────────────────────────────────────────── */
    .demo-modal {
      background: #FFFFFF;
      border-radius: 24px;
      padding: 44px 40px 36px;
      width: 100%;
      max-width: 500px;
      position: relative;
      max-height: 92vh;
      overflow-y: auto;
      box-shadow: 0 25px 60px rgba(0,0,0,0.3);
      transform: translateY(30px) scale(0.97);
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .demo-modal-overlay.open .demo-modal {
      transform: translateY(0) scale(1);
    }
    .demo-modal::-webkit-scrollbar { width: 4px; }
    .demo-modal::-webkit-scrollbar-thumb { background: #2DD4BF; border-radius: 4px; }

    /* ── BOTÓN CERRAR ────────────────────────────────────────── */
    .demo-modal-close {
      position: absolute;
      top: 16px; right: 20px;
      background: none; border: none;
      font-size: 20px; color: #9CA3AF;
      cursor: pointer;
      transition: color 0.2s ease, transform 0.2s ease;
      padding: 4px;
      display: flex; align-items: center; justify-content: center;
    }
    .demo-modal-close:hover {
      color: #111827;
      transform: rotate(90deg);
    }

    /* ── TÍTULO Y SUBTÍTULO ──────────────────────────────────── */
    .demo-modal-title {
      font-family: 'Inter', 'Roboto', sans-serif;
      font-size: 26px; font-weight: 800;
      color: #111827;
      text-align: center; margin-bottom: 8px;
    }
    .demo-modal-sub {
      font-size: 14px; color: #6B7280;
      text-align: center; margin-bottom: 32px;
      line-height: 1.5;
    }

    /* ── FORMULARIO ──────────────────────────────────────────── */
    .demo-form { display: flex; flex-direction: column; }
    .demo-form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .demo-form-group {
      margin-bottom: 22px;
      position: relative;
    }
    .demo-form-group input {
      width: 100%;
      border: none;
      border-bottom: 1.5px solid #D1D5DB;
      background: transparent;
      padding: 10px 0;
      font-size: 15px;
      font-family: 'DM Sans', 'Roboto', sans-serif;
      color: #111827;
      outline: none;
      transition: border-color 0.25s ease;
      border-radius: 0;
    }
    .demo-form-group input::placeholder { color: #9CA3AF; font-size: 14px; }
    .demo-form-group input:focus { border-bottom-color: #2DD4BF; }
    .demo-form-group::after {
      content: '';
      position: absolute;
      bottom: 22px; left: 0;
      width: 0; height: 2px;
      background: #2DD4BF;
      transition: width 0.3s ease;
    }
    .demo-form-group:focus-within::after { width: 100%; }

    /* ── CHECKBOX ────────────────────────────────────────────── */
    .demo-form-check {
      display: flex; align-items: flex-start; gap: 10px;
      font-size: 13px; color: #6B7280;
      margin-bottom: 24px; cursor: pointer; line-height: 1.5;
    }
    .demo-form-check input[type="checkbox"] {
      width: 16px; height: 16px; min-width: 16px;
      margin-top: 2px;
      accent-color: #2DD4BF; cursor: pointer;
    }
    .demo-link {
      color: #2DD4BF; font-weight: 600;
      text-decoration: none;
    }
    .demo-link:hover { text-decoration: underline; }

    /* ── BOTÓN SUBMIT ────────────────────────────────────────── */
    .demo-form-submit {
      width: 100%;
      background: linear-gradient(135deg, #3B82F6 0%, #2DD4BF 100%);
      color: #FFFFFF;
      font-family: 'Inter', 'Roboto', sans-serif;
      font-size: 15px; font-weight: 700;
      letter-spacing: 1.5px;
      padding: 16px;
      border-radius: 50px; border: none;
      cursor: pointer;
      transition: all 0.3s ease;
      text-transform: uppercase;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      margin-bottom: 12px;
    }
    .demo-form-submit:hover {
      transform: scale(1.02);
      box-shadow: 0 8px 25px rgba(59,130,246,0.4);
      filter: brightness(1.05);
    }
    .demo-form-submit:disabled {
      opacity: 0.7; cursor: not-allowed;
      transform: none; box-shadow: none;
    }
    .btn-spinner {
      width: 16px; height: 16px;
      border: 2px solid rgba(255,255,255,0.35);
      border-top-color: #FFFFFF;
      border-radius: 50%;
      animation: modalSpin 0.7s linear infinite;
      display: none;
    }
    .demo-form-submit.loading .btn-spinner { display: block; }
    @keyframes modalSpin { to { transform: rotate(360deg); } }

    /* ── TÉRMINOS ────────────────────────────────────────────── */
    .demo-form-terms {
      text-align: center; font-size: 12px; color: #9CA3AF;
    }

    /* ── TOAST ───────────────────────────────────────────────── */
    .demo-toast {
      position: fixed;
      bottom: 30px; right: 30px;
      background: #111827; color: #FFFFFF;
      padding: 16px 20px;
      border-radius: 14px;
      border-left: 4px solid #2DD4BF;
      box-shadow: 0 10px 40px rgba(0,0,0,0.35);
      font-size: 14px; font-weight: 500;
      z-index: 99999;
      display: flex; align-items: center; gap: 10px;
      max-width: 340px; line-height: 1.4;
      transform: translateY(100px); opacity: 0;
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .demo-toast.show { transform: translateY(0); opacity: 1; }
    .demo-toast.error { border-left-color: #B40909; }
    .toast-icon { font-size: 20px; flex-shrink: 0; color: #2DD4BF; }
    .demo-toast.error .toast-icon { color: #B40909; }

    /* ── RESPONSIVE ──────────────────────────────────────────── */
    @media (max-width: 540px) {
      .demo-modal { padding: 36px 22px 28px; border-radius: 20px; }
      .demo-modal-title { font-size: 22px; }
      .demo-form-row { grid-template-columns: 1fr; gap: 0; }
      .demo-toast { bottom: 16px; right: 16px; left: 16px; max-width: 100%; }
    }
    </style>
</head>

<body>

